---
import TripItinerary from '../../../components/TripItinerary.astro';
import TripPlaceholder from '../../../components/TripPlaceholder.astro';
import { tripCollection, type TripEntry } from '../../../data/trips';
import { isPlaceholderTrip } from '../../../lib/trips';

export function getStaticPaths() {
  return tripCollection.map(trip => ({
    params: { slug: trip.slug },
    props: { trip },
  }));
}
interface Props { trip: TripEntry; }
const { trip } = Astro.props;
---
{isPlaceholderTrip(trip)
  ? <TripPlaceholder trip={trip} />
  : <TripItinerary trip={trip} />}
