---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TripStatus from '../components/TripStatus.astro';
import TravelMap from '../components/TravelMap.astro';
import { trips } from '../data/trips';
import { durationDays, formatDateRange, formatDate } from '../lib/trips';
import { withBase } from '../lib/urls';
import imageCredits from '../../public/images/credits.json';
import type { TripDestination } from '../data/trips';

const orderedTrips = [...trips].sort((a, b) => b.startDate.localeCompare(a.startDate));
const featured = orderedTrips[0];
const totalDays = trips.reduce((sum, trip) => sum + durationDays(trip), 0);
const totalCountries = new Set(trips.map((trip) => trip.countryCode)).size;
const featuredChapter = String(trips.findIndex(trip => trip.slug === featured?.slug) + 1).padStart(2, '0');
const featuredZh = featured?.language === 'zh-CN';
const featuredLocale = featuredZh ? 'zh-CN' : 'en-US';
const featuredRoute = featured?.mapRoute?.map(id => featured.destinations.find(stop => stop.id === id)).filter((stop): stop is TripDestination => !!stop);
const featuredCredit = (imageCredits.images as Array<{file: string; source: string; license: string; licenseUrl: string; author?: string}>).find(image => `/images/${image.file}` === featured?.cover);
---
<Layout image={featured?.cover}>
  <section class="home-hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> A PERSONAL TRAVEL ATLAS</p>
      <h1 id="hero-title">Somewhere new.<br /><em>Something to<br class="hero-title-break" /> remember.</em></h1>
      <p class="hero-description">A home for the places to go, the little things to find, and the stories to bring back. One journey at a time.</p>
      <div class="hero-actions"><a class="button button-primary" href="#collection">Explore the collection <Icon name="arrow-right" size={19} /></a><a class="text-link" href="#atlas">Find it on the map <Icon name="globe" size={18} /></a></div>
      <div class="hero-footnote"><span class="footnote-rule"></span><p>Less rushing. More looking around.</p></div>
    </div>
    {featured && <a class="hero-photo-link" href={withBase(`trips/${featured.slug}/`)} lang={featured.language ?? 'en'} aria-label={featuredZh ? `查看${featured.title}，${formatDateRange(featured, featuredLocale)}` : `Explore ${featured.title}, ${formatDateRange(featured)}`} data-astro-prefetch>
      <div class="hero-photo">
        <img src={withBase(featured.cover)} alt={featured.coverAlt} width="1800" height="1201" fetchpriority="high" />
        <div class="photo-topline"><span>{featuredZh ? featured.title : 'THE JOURNEY STARTS HERE'}</span><span>{featured.countryCode} / {featured.startDate.slice(0, 4)}</span></div>
        <span class="photo-japanese" lang={featured.countryCode === 'JP' ? 'ja' : 'en'} aria-hidden="true">{featured.countryCode === 'JP' ? '日本' : featured.countryCode}</span>
        <div class="hero-photo-bottom"><div><span class="photo-eyebrow">{featuredZh ? '第' : 'CHAPTER '} {featuredChapter}{featuredZh && '段旅程'}</span><h2>{featured.country}{!featuredZh && <span class="photo-title-period">.</span>}</h2><p>{formatDateRange(featured, featuredLocale)} <span>·</span> {durationDays(featured)}{featuredZh ? '天' : ' days'}</p></div><span class="photo-arrow"><Icon name="arrow-up-right" size={25} /></span></div>
      </div>
      <div class="photo-caption"><span><span class="status-dot"></span> {featuredZh ? `${featured.travelers ? `${featured.travelers}个人，` : ''}${durationDays(featured)}天的旅程` : 'A new chapter, taking shape'}</span><span>{featuredZh ? '查看行程' : 'Let’s go somewhere'} <Icon name="arrow-up-right" size={14} /></span></div>
      <div class="hero-stamp" aria-hidden="true"><svg viewBox="0 0 100 100"><defs><path id="stamp-circle" d="M50 50m-35 0a35 35 0 1 1 70 0a35 35 0 1 1-70 0"/></defs><text><textPath href="#stamp-circle" textLength="214">STAY CURIOUS · GO ELSEWHERE · </textPath></text></svg><Icon name="compass" size={31} /></div>
    </a>}
  </section>

  <div class="collection-ticker"><div class="container ticker-inner"><p><span class="tiny-star" aria-hidden="true">✳</span> A little planning. A lot of possibility.</p><div class="ticker-stats"><span><strong>{String(trips.length).padStart(2, '0')}</strong> {trips.length === 1 ? 'journey' : 'journeys'}</span><span><strong>{String(totalDays).padStart(2, '0')}</strong> days to explore</span><span><strong>{String(totalCountries).padStart(2, '0')}</strong> {totalCountries === 1 ? 'country in the atlas' : 'countries in the atlas'}</span></div></div></div>

  <section class="collection-section container section-space" id="collection" aria-labelledby="collection-title">
    <div class="section-heading"><div><p class="eyebrow">01 / THE COLLECTION</p><h2 id="collection-title">Every trip, <em>its own story.</em></h2></div><p class="section-intro">Plans for now. Memories for later.<br />A growing collection of places and possibilities.</p></div>
    <div class="collection-toolbar"><div class="collection-filters" aria-label="Filter trips"><button type="button" class="filter-button is-active" data-trip-filter="all" aria-pressed="true">All journeys <span>{trips.length}</span></button><button type="button" class="filter-button" data-trip-filter="planned" aria-pressed="false">In the making <span>{trips.filter(trip => trip.status !== 'completed').length}</span></button><button type="button" class="filter-button" data-trip-filter="completed" aria-pressed="false">Remembered <span>{trips.filter(trip => trip.status === 'completed').length}</span></button></div><span class="collection-small-note">Good things take a little planning <Icon name="sun" size={17} /></span></div>
    <div class="trip-grid">
      {orderedTrips.map((trip) => <article class="trip-card" data-trip-card data-trip-kind={trip.status === 'completed' ? 'completed' : 'planned'} lang={trip.language ?? 'en'}>
        <a class="trip-card-cover" href={withBase(`trips/${trip.slug}/`)} data-astro-prefetch aria-label={trip.language === 'zh-CN' ? `查看${trip.title}` : `Explore ${trip.title}`}><img src={withBase(trip.cover)} alt={trip.coverAlt} width="1800" height="1201" loading="lazy" /><span class="trip-card-number">{trip.language === 'zh-CN' ? '旅程' : 'CHAPTER'} {String(trips.findIndex(item => item.slug === trip.slug) + 1).padStart(2, '0')}</span><span class="trip-card-arrow"><Icon name="arrow-up-right" size={24} /></span></a>
        <div class="trip-card-body"><div class="trip-card-meta"><span>{trip.country} <span class="meta-divider">/</span> {trip.startDate.slice(0, 4)}</span><TripStatus trip={trip} /></div><h3><a href={withBase(`trips/${trip.slug}/`)} data-astro-prefetch>{trip.title}{trip.language !== 'zh-CN' && <span aria-hidden="true">.</span>}</a></h3><p>{trip.summary}</p><div class="trip-card-details"><span><Icon name="calendar" size={16} /> {formatDateRange(trip, trip.language === 'zh-CN' ? 'zh-CN' : 'en-US')}</span><span>{durationDays(trip)}{trip.language === 'zh-CN' ? `天 · ${durationDays(trip) - 1}晚` : ' days'}</span></div><div class="trip-card-route"><span>{trip.language === 'zh-CN' ? (trip.itineraryStatus === 'agreed' ? '确定路线' : '计划路线') : (trip.itineraryStatus === 'agreed' ? 'THE ROUTE' : 'SUGGESTED ROUTE')}</span><p>{(trip.routeSummary ?? trip.destinations.map(stop => stop.name)).join(' → ')}</p></div></div>
      </article>)}
      <aside class="next-chapter"><span class="next-chapter-top">THERE’S ALWAYS ANOTHER CHAPTER</span><div class="next-chapter-illustration" aria-hidden="true"><svg width="144" height="144" viewBox="0 0 144 144" fill="none"><circle cx="72" cy="72" r="47" stroke="currentColor" stroke-width="1"/><ellipse cx="72" cy="72" rx="24" ry="47" stroke="currentColor" stroke-width="1"/><path d="M25 72h94M34 47h76M34 97h76M72 25v94" stroke="currentColor" stroke-width="1"/><path d="m107 21 5-12 5 12 12 5-12 5-5 12-5-12-12-5 12-5Z" fill="#dd6745" stroke="#f7f5ef" stroke-width="5"/></svg></div><h3>The best part?<br /><em>There’s more out there.</em></h3><p>This atlas grows with every journey.<br />The next destination is a blank page.</p><a class="text-link" href="#about">A little more about this atlas <Icon name="arrow-right" size={17} /></a><span class="next-chapter-bottom">ROOM FOR WHAT COMES NEXT <span aria-hidden="true">↗</span></span></aside>
    </div>
    <div class="collection-empty" data-trip-empty hidden><Icon name="compass" size={37} /><h3>Still a story in the making.</h3><p>The first trip is being planned. Memories will find their place here when the journey is done.</p><button class="text-link" type="button" data-reset-filter>See all journeys <Icon name="arrow-right" size={17} /></button></div>
    <p class="sr-only" data-filter-status aria-live="polite">Showing {trips.length} {trips.length === 1 ? 'journey' : 'journeys'}.</p>
  </section>

  {featured && <section class="atlas-section section-space" id="atlas" aria-labelledby="atlas-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / THE ATLAS</p><h2 id="atlas-title">Put a pin in <em>possibility.</em></h2></div><p class="section-intro">A different way to see the journey.<br />Pick a city. Get a little closer.</p></div><div class="atlas-layout"><aside class="atlas-sidebar" lang={featured.language ?? 'en'}><div class="atlas-sidebar-heading"><span class="atlas-small-label"><Icon name="compass" size={17} /> {featuredZh ? '旅途中的地点' : 'ON THE MAP'}</span><h3>{featured.country}{!featuredZh && <span>.</span>}</h3><p>{formatDateRange(featured, featuredLocale)} · {featuredZh ? '行程路线' : 'Travel route'}</p></div><div class="atlas-stops">{featured.destinations.map((stop, index) => <div class="atlas-stop"><button type="button" data-map-select="home-atlas" data-stop-id={stop.id} aria-pressed="false" disabled><span class="stop-number">{String(index + 1).padStart(2, '0')}</span><span class="stop-copy"><strong>{stop.name}</strong><span>{stop.description}</span></span><Icon name="arrow-up-right" size={19} /></button><a class="city-map-link" href={`https://www.google.com/maps/search/?api=1&query=${stop.lat},${stop.lng}`} target="_blank" rel="noopener noreferrer">{featuredZh ? `在地图上查看${stop.name}` : `Open ${stop.name} in Maps`} <Icon name="external" size={12} /></a></div>)}</div><a class="atlas-trip-link" href={withBase(`trips/${featured.slug}/`)} data-astro-prefetch>{featuredZh ? '查看完整行程' : 'See the whole journey'} <Icon name="arrow-right" size={18} /></a></aside><TravelMap id="home-atlas" destinations={featured.destinations} route={featuredRoute} country={featured.country} locale={featured.language ?? 'en'} dateLabel={formatDate(featured.startDate, { month: 'long', year: 'numeric', day: undefined }, featuredLocale)} label={featuredZh ? '日本秋日之旅地图' : `${featured.country} travel map`} /></div><p class="route-note" lang={featured.language ?? 'en'}>{featuredZh ? '连线包含返回与换乘，表示旅行顺序；地图上的地点为概略位置。' : 'Lines show the order of the trip, including return journeys. Locations are approximate.'}</p></div></section>}

  <section class="about-section container section-space" id="about" aria-labelledby="about-title"><div class="about-mark" aria-hidden="true">✳</div><div class="about-copy"><p class="eyebrow">03 / THE IDEA</p><h2 id="about-title">A place to plan.<br /><em>A reason to wander.</em></h2><p>Good trips start long before the suitcase comes out. With a saved place, a half-formed idea, or a city that won’t quite leave your mind.</p><p>Elsewhere is a little home for all of it: itineraries while they’re taking shape, maps to connect the dots, and stories to keep when the journey’s over.</p><span class="about-signoff">Here’s to the next somewhere. <span aria-hidden="true">↗</span></span></div><div class="about-note"><span class="about-note-label">A NOTE TO SELF</span><p>Leave a little<br />room for<br /><em>the unexpected.</em></p><Icon name="sun" size={34} /><span class="about-note-footer">THE BEST BITS AREN’T ALWAYS ON THE PLAN.</span></div></section>
  {featuredCredit && <div class="container home-image-credit image-credits">Photo: <a href={featuredCredit.source} target="_blank" rel="noopener noreferrer">{featuredCredit.author ?? 'Wikimedia Commons'}</a> / <a href={featuredCredit.licenseUrl} target="_blank" rel="noopener noreferrer">{featuredCredit.license}</a>. Resized and converted to WebP.</div>}
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-trip-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-trip-card]');
  function filterTrips(filter: string) {
    let visible = 0;
    filters.forEach(button => { const active = button.dataset.tripFilter === filter; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
    cards.forEach(card => { card.hidden = filter !== 'all' && card.dataset.tripKind !== filter; if (!card.hidden) visible++; });
    const empty = document.querySelector<HTMLElement>('[data-trip-empty]');
    if (empty) empty.hidden = visible > 0;
    const teaser = document.querySelector<HTMLElement>('.next-chapter');
    if (teaser) teaser.hidden = visible === 0;
    const status = document.querySelector('[data-filter-status]');
    if (status) status.textContent = `Showing ${visible} ${visible === 1 ? 'journey' : 'journeys'}.`;
  }
  filters.forEach(button => button.addEventListener('click', () => filterTrips(button.dataset.tripFilter!)));
  document.querySelector('[data-reset-filter]')?.addEventListener('click', () => { filterTrips('all'); filters[0]?.focus(); });
</script>
