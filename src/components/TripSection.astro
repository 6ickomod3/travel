---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  open?: boolean;
  class?: string;
  locale?: 'zh-CN' | 'en';
}
const { id, title, open = false, class: className, locale = 'en' } = Astro.props;
const titleId = `${id}-title`;
const contentId = `${id}-content`;
const summaryId = `${id}-summary`;
const hasSummary = Astro.slots.has('summary');
---

<section class:list={['trip-section', 'container', className]} id={id} aria-labelledby={titleId} lang={locale}>
  <details class="trip-section-details" data-trip-section={id} open={open}>
    <summary class="trip-section-summary" aria-controls={contentId} aria-describedby={hasSummary ? summaryId : undefined}>
      <h2 class="trip-section-heading" aria-label={title}>
        <span class="trip-section-title" id={titleId}>{title}</span>
        {hasSummary && <span class="trip-section-meta" id={summaryId}><slot name="summary" /></span>}
        <span class="trip-section-chevron" aria-hidden="true"><Icon name="chevron-down" size={20} /></span>
      </h2>
    </summary>
    <div class="trip-section-content" id={contentId}><slot /></div>
  </details>
</section>

<style>
  .trip-section { min-width: 0; padding-block: 28px; border-top: 1px solid var(--line); scroll-margin-top: 24px; }
  .trip-section-details { min-width: 0; }
  .trip-section-summary { display: block; min-height: 44px; padding: 3px 0; cursor: pointer; list-style: none; }
  .trip-section-heading { display: grid; grid-template-columns: minmax(0, 1fr) 28px; align-items: start; gap: 9px 18px; min-width: 0; margin: 0; font-weight: 400; }
  .trip-section-summary::-webkit-details-marker { display: none; }
  .trip-section-summary::marker { content: ''; }
  .trip-section-title { min-width: 0; grid-column: 1; margin: 0; color: var(--ink); font-family: var(--serif); font-size: clamp(30px, 3.6vw, 44px); font-weight: 400; line-height: 1.25; letter-spacing: -.4px; overflow-wrap: anywhere; }
  .trip-section:lang(zh-CN) .trip-section-title { line-height: 1.5; letter-spacing: .015em; }
  .trip-section-meta { display: flex; grid-column: 1; flex-wrap: wrap; align-items: baseline; gap: 5px 18px; min-width: 0; color: var(--ink-soft); font-family: var(--sans); font-size: 13px; line-height: 1.85; overflow-wrap: anywhere; }
  .trip-section-meta :global(*) { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
  .trip-section-chevron { display: grid; place-items: center; grid-column: 2; grid-row: 1 / span 2; width: 28px; height: 32px; margin-top: 7px; color: var(--ink-soft); transition: transform .18s; }
  .trip-section-details[open] > .trip-section-summary .trip-section-chevron { transform: rotate(180deg); }
  .trip-section-summary:hover .trip-section-chevron { color: var(--accent-deep); }
  .trip-section-summary:focus-visible { outline: 2px solid var(--accent-deep); outline-offset: 7px; border-radius: 3px; }
  .trip-section-content { min-width: 0; padding-top: 23px; }
  @media (max-width: 600px) {
    .trip-section { padding-block: 22px; }
    .trip-section-heading { gap: 7px 12px; }
    .trip-section-title { font-size: 29px; line-height: 1.35; }
    .trip-section-meta { gap: 4px 12px; font-size: 12px; line-height: 1.9; }
    .trip-section-chevron { margin-top: 4px; }
    .trip-section-content { padding-top: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trip-section-chevron { transition: none; }
  }
  @media print {
    .trip-section { padding-block: 18px; border: 0; }
    .trip-section-details { display: block; }
    .trip-section-details::details-content { content-visibility: visible !important; height: auto !important; overflow: visible !important; }
    .trip-section-details > .trip-section-content { display: block !important; content-visibility: visible !important; }
    .trip-section-summary { display: block; min-height: 0; padding: 0; cursor: default; break-after: avoid; }
    .trip-section-heading { display: block; }
    .trip-section-title { display: block; font-size: 22px; line-height: 1.4; }
    .trip-section-meta { margin-top: 5px; font-size: 10px; line-height: 1.7; }
    .trip-section-chevron { display: none; }
    .trip-section-content { padding-top: 13px; }
  }
</style>
