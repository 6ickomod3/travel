---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import type { TripPlaceholder as PlaceholderTrip } from '../data/trips';
import { withBase } from '../lib/urls';

interface Props { trip: PlaceholderTrip; }
const { trip } = Astro.props;
const yearTitle = trip.title.match(/^(.*?)\s+([’']\d{2})$/);
const titleLead = yearTitle?.[1] ?? trip.title;
const titleTail = yearTitle?.[2];
---
<Layout
  lang="en"
  title={`${trip.title} | The Journey Atlas`}
  description={`${trip.country} ${trip.year}. ${trip.summary} Dates to be decided.`}
  image={trip.cover}
  imageAlt={trip.coverAlt}
>
  <section class="placeholder-page container" aria-labelledby="placeholder-title">
    <a class="text-link placeholder-back" href={`${withBase()}#collection`}><Icon name="arrow-left" size={15} /> Back to collection</a>

    <div class="placeholder-hero">
      <div class="placeholder-hero-copy">
        <h1 id="placeholder-title">{titleLead}{titleTail && <>{' '}<em>{titleTail}</em></>}</h1>
        <p class="placeholder-status">{trip.summary}</p>
        <dl class="placeholder-facts">
          <div><dt>Year</dt><dd>{trip.year}</dd></div>
          <div><dt>Dates</dt><dd>To be decided</dd></div>
        </dl>
      </div>

      <figure class="placeholder-artwork">
        <div class="placeholder-artwork-frame"><img src={withBase(trip.cover)} alt={trip.coverAlt} width="1800" height="1200" fetchpriority="high" /></div>
        <figcaption>{trip.coverCredit}</figcaption>
      </figure>
    </div>
  </section>
</Layout>

<style>
  .placeholder-page { padding-block: 28px 56px; }
  .placeholder-back { font-size: 12px; color: var(--ink-soft); }
  .placeholder-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.03fr); align-items: center; gap: 65px; padding-top: 32px; }
  .placeholder-hero-copy { min-width: 0; }
  .placeholder-hero-copy h1 { font-family: var(--serif); font-size: clamp(74px, 7.2vw, 106px); line-height: 1.03; letter-spacing: -1.8px; }
  .placeholder-hero-copy h1 em { color: var(--accent-deep); }
  .placeholder-status { margin-top: 20px; color: var(--ink-soft); font-size: 16px; line-height: 1.7; }
  .placeholder-facts { display: grid; grid-template-columns: auto auto; justify-content: start; gap: 20px 32px; max-width: 380px; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); }
  .placeholder-facts > div { display: grid; gap: 6px; }
  .placeholder-facts dt { color: var(--ink-soft); font-size: 11px; line-height: 1.5; }
  .placeholder-facts dd { margin: 0; font-size: 14px; line-height: 1.5; }
  .placeholder-artwork { margin: 0; min-width: 0; }
  .placeholder-artwork-frame { aspect-ratio: 3 / 2; overflow: hidden; border-radius: 6px 70px 6px 6px; background: var(--paper-deep); border: 1px solid var(--line); box-shadow: 0 18px 45px #23372c08; }
  .placeholder-artwork img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .placeholder-artwork figcaption { margin-top: 13px; color: var(--ink-soft); font-size: 10px; line-height: 1.8; }

  @media (max-width: 1000px) {
    .placeholder-hero { gap: 39px; }
    .placeholder-hero-copy h1 { font-size: 86px; }
  }
  @media (max-width: 800px) {
    .placeholder-hero { gap: 28px; }
    .placeholder-hero-copy h1 { font-size: 75px; }
    .placeholder-artwork-frame { border-top-right-radius: 49px; }
  }
  @media (max-width: 600px) {
    .placeholder-page { padding-block: 24px 40px; }
    .placeholder-hero { grid-template-columns: 1fr; gap: 28px; padding-top: 25px; }
    .placeholder-hero-copy h1 { font-size: clamp(74px, 18vw, 89px); }
    .placeholder-status { margin-top: 17px; }
    .placeholder-facts { margin-top: 22px; padding-top: 18px; }
    .placeholder-artwork-frame { border-top-right-radius: 44px; }
    .placeholder-artwork figcaption { font-size: 9px; }
  }
</style>
