---
interface Props { light?: boolean; }
const { light = false } = Astro.props;
---
<span class:list={['brand', { 'brand-light': light }]}>
  <svg class="brand-symbol" width="31" height="31" viewBox="0 0 64 64" aria-hidden="true">
    <g fill="currentColor" transform="translate(32 32)"><path d="M0-29 6-8 0-3-6-8Z"/><path d="M0 29 6 8 0 3-6 8Z"/><path d="M29 0 8 6 3 0 8-6Z"/><path d="M-29 0-8 6-3 0-8-6Z"/></g><circle cx="32" cy="32" r="4" fill="#dd6745"/>
  </svg>
  <span>elsewhere<span class="brand-period">.</span></span>
</span>
