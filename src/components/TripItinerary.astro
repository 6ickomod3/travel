---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import TripStatus from './TripStatus.astro';
import TravelMap from './TravelMap.astro';
import TripFlights from './TripFlights.astro';
import TripPlanning from './TripPlanning.astro';
import TripChecklist from './TripChecklist.astro';
import TripCosts from './TripCosts.astro';
import TripReferences from './TripReferences.astro';
import TripStamps from './TripStamps.astro';
import TripStampGuide from './TripStampGuide.astro';
import { tripCollection, type Trip, type TripDestination, type TripStay } from '../data/trips';
import { durationDays, formatDateRange, formatDate } from '../lib/trips';
import { withBase } from '../lib/urls';
import { getImageCredit, getLicensedImageCredit } from '../lib/image-credits';

interface Props { trip: Trip; }
const { trip } = Astro.props;
const isZh = trip.language === 'zh-CN';
const locale = isZh ? 'zh-CN' : 'en';
const dateLocale = isZh ? 'zh-CN' : 'en-US';
const text = (zh: string, en: string) => isZh ? zh : en;
const date = (value: string, options: Intl.DateTimeFormatOptions = {}) => formatDate(value, options, dateLocale);
const dateRange = formatDateRange(trip, dateLocale);
const dayNumber = (dayDate: string) => durationDays({ startDate: trip.startDate, endDate: dayDate });
const number = (value: number) => new Intl.NumberFormat(dateLocale, { maximumFractionDigits: 1 }).format(value);
const money = (value: number, currency: string) => new Intl.NumberFormat(dateLocale, { style: 'currency', currency }).format(value);
const chapter = String(tripCollection.findIndex(item => item.slug === trip.slug) + 1).padStart(2, '0');
const titleBreak = trip.title.search(/[，,]/);
const titleParts = titleBreak >= 0
  ? [trip.title.slice(0, titleBreak + 1), trip.title.slice(titleBreak + 1).trim()]
  : [trip.title];
const cityName = (id: string) => trip.destinations.find(stop => stop.id === id)?.name || id;
const isThisJapan = trip.slug === 'japan-2026';
const isAgreed = trip.itineraryStatus === 'agreed';
const monthLabel = date(trip.startDate, { month: 'long', year: 'numeric', day: undefined });
const destinationDays = (id: string) => trip.days.filter(day => day.destinationId === id).length;
const route = (trip.mapRoute?.length ? trip.mapRoute : trip.destinations.map(stop => stop.id))
  .map(id => trip.destinations.find(stop => stop.id === id))
  .filter((stop): stop is TripDestination => Boolean(stop));
const stays = trip.stays ?? [];
const hasCosts = stays.some(stay => stay.checkIns.some(segment => segment.cost));
const flights = trip.flights ?? [];
const ticketOptions = trip.ticketOptions ?? [];
const bookingWindows = trip.bookingWindows ?? [];
const checklist = trip.checklist ?? [];
const practicalNotes = trip.practicalNotes ?? [];
const sources = trip.sources ?? [];
const getSourceById = (id: string) => sources.find(source => source.id === id);
const sourcesFor = (ids?: string[]) => (ids ?? []).flatMap(id => {
  const source = getSourceById(id);
  return source ? [source] : [];
});
const nightsBetween = (checkIn: string, checkOut: string) => durationDays({ startDate: checkIn, endDate: checkOut }) - 1;
const stayNights = (stay: TripStay) => stay.checkIns.reduce((total, segment) => total + nightsBetween(segment.checkIn, segment.checkOut), 0);
const totalNights = stays.reduce((total, stay) => total + stayNights(stay), 0);
const bookedNights = stays.filter(stay => stay.status === 'booked').reduce((total, stay) => total + stayNights(stay), 0);
const pendingNights = totalNights - bookedNights;
const stayById = (id?: string) => stays.find(stay => stay.id === id);
const stayStatus = (stay: TripStay) => stay.status === 'booked' ? text('已订', 'Booked') : text('待确认', 'Awaiting confirmation');
const hasPreparations = practicalNotes.length > 0 || ticketOptions.length > 0 || bookingWindows.length > 0 || Boolean(trip.stampGuide);
const photoCredit = trip.coverCredit.replace(/^(?:Photo:|图片来源：|图片：)\s*/i, '');
const heroImage = getImageCredit(trip.cover);
const heroCredit = getLicensedImageCredit(trip.cover);
---
<Layout
  lang={locale}
  title={`${trip.title} — ${dateRange} | The Journey Atlas`}
  description={`${trip.summary} ${dateRange}${text('。', '. ')}${text('每日行程、住宿安排、行前准备与官方资料。', 'Daily itinerary, accommodation, preparations, and official sources.')}`}
  image={trip.cover}
  imageAlt={trip.coverAlt}
>
  <div class:list={['trip-page', { 'trip-page-zh': isZh }]}>
    <div class="trip-breadcrumb container">
      <a href={`${withBase()}#collection`}><Icon name="arrow-left" size={14} /> {text('旅行列表', 'Trips')}</a>
      <span aria-hidden="true">/</span>
      <span>{trip.country} {trip.startDate.slice(0, 4)}</span>
    </div>

    <section class="trip-hero container" aria-labelledby="trip-title">
      <div class="trip-hero-copy">
        <p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> {text('旅行', 'TRIP')} {chapter} / {trip.country.toUpperCase()}</p>
        <h1 id="trip-title">{titleParts.map((part, index) => <>{index > 0 && <wbr />}<span class="trip-title-part">{part}</span></>)}</h1>
        <p>{trip.summary}</p>
        <div class="trip-facts">
          <span><Icon name="calendar" size={16} /> {dateRange}</span>
          <span><Icon name="sun" size={16} /> {durationDays(trip)} {text('天', 'days')}{totalNights > 0 && <> · {totalNights} {text('晚', 'nights')}</>}</span>
          {trip.travelers && <span>{trip.travelers} {text('人同行', trip.travelers === 1 ? 'traveler' : 'travelers')}</span>}
          <TripStatus trip={trip} locale={locale} />
        </div>
        <div class="trip-hero-actions">
          <a class="button button-primary" href={checklist.length > 0 ? '#checklist' : '#itinerary'}>{checklist.length > 0 ? text('查看待办与待确认', 'View to do and to check') : text('查看每日行程', 'View itinerary')} <Icon name="arrow-down" size={16} /></a>
          <button class="button button-secondary" type="button" data-print-trip><Icon name="download" size={15} /> {text('打印行程', 'Print itinerary')}</button>
        </div>
      </div>
      <figure class="trip-hero-figure">
        <div class="trip-hero-image">
          <img src={withBase(trip.cover)} alt={trip.coverAlt} width={heroImage?.width ?? 1800} height={heroImage?.height ?? 1200} style={`object-position: ${heroImage?.objectPosition ?? '50% 50%'}`} fetchpriority="high" />
          <span class="trip-image-caption">{trip.country}</span>
        </div>
        <figcaption class="trip-photo-credits">
          {heroCredit ? <><span>{text('主图：', 'Cover photo: ')}</span><a href={heroCredit.source} target="_blank" rel="noopener noreferrer">{heroCredit.author ?? text('照片原页', 'Original photo')}</a><span aria-hidden="true"> · </span><a href={heroCredit.licenseUrl} target="_blank" rel="noopener noreferrer">{heroCredit.license}</a>{heroCredit.changes && <span class="photo-changes">{text(heroCredit.changes, 'Resized and converted to WebP; no crop saved.')}</span>}</> : <><span>{text('主图：', 'Cover photo: ')}{photoCredit}</span>{heroImage && <><span aria-hidden="true"> · </span><a href={withBase(heroImage.creditsPath)} target="_blank" rel="noopener noreferrer">{text('照片来源与授权', 'Photo sources and licenses')}</a></>}</>}
        </figcaption>
      </figure>
    </section>

    <nav class="trip-subnav" aria-label={text('行程章节', 'Trip sections')}>
      <div class="container">
        <div class="trip-subnav-links rich-subnav-links">
          {checklist.length > 0 && <a href="#checklist">{text('待办与待确认', 'To do / to check')}</a>}
          {flights.length > 0 && <a href="#flights">{text('航班信息', 'Flights')}</a>}
          <a href="#route">{text('旅行路线', 'Route')}</a>
          {stays.length > 0 && <a href="#stays">{text('住宿安排', 'Accommodation')}</a>}
          <a href="#itinerary">{text('每日行程', 'Daily itinerary')}</a>
          {hasPreparations && <a href="#preparations">{text('行前准备', 'Preparations')}</a>}
          {sources.length > 0 && <a href="#sources">{text('官方资料', 'Official sources')}</a>}
          {hasCosts && <a href="#costs">{text('费用', 'Costs')}</a>}
        </div>
        <span class="trip-subnav-note"><span class="status-dot"></span> {isAgreed ? text('行程已商定', 'Agreed itinerary') : text('行程草案', 'Draft itinerary')}</span>
      </div>
    </nav>

    {checklist.length > 0 && <TripChecklist items={checklist} sources={sources} locale={locale} hasTicketOptions={ticketOptions.length > 0} hasBookingWindows={bookingWindows.length > 0} />}

    <div class="planning-note container">
      <Icon name="compass" size={21} />
      <div>
        <strong>{isAgreed ? text('行程已商定', 'Agreed itinerary') : text('行程草案', 'Draft itinerary')}</strong>
        <p>{trip.routeNote}</p>
      </div>
    </div>

    {flights.length > 0 && <TripFlights flights={flights} sources={sources} locale={locale} />}

    <section class="route-section container" id="route" aria-labelledby="route-title">
      <div class="section-heading">
        <div><h2 id="route-title">{text('旅行路线', 'Route')}</h2></div>
        <p class="section-intro">{trip.destinations.length} {text('个目的地', 'destinations')} · {durationDays(trip)} {text('天行程', 'days')}{trip.walkingSummary && <><br />{text('古道徒步', 'Trail walking')} {trip.walkingSummary.days} {text('天', 'days')} · {text('约', 'about ')}{number(trip.walkingSummary.distanceKm)} {text('公里', 'km')}</>}</p>
      </div>
      {Boolean(trip.routeSummary?.length) && <ol class="route-overview" aria-label={text('行程顺序', 'Route order')} role="list">{trip.routeSummary!.map((stop, index) => <li><span>{stop}</span>{index < trip.routeSummary!.length - 1 && <span aria-hidden="true" class="route-overview-arrow">→</span>}</li>)}</ol>}
      <div class="trip-route-layout">
        <TravelMap id="trip-route" destinations={trip.destinations} route={route} variant="route" label={text(`${trip.country}旅行路线地图`, `${trip.country} itinerary map`)} country={trip.country} dateLabel={monthLabel} locale={locale} />
        <aside class="route-stops">
          <p>{text('目的地', 'DESTINATIONS')}</p>
          {trip.destinations.map((stop, index) => <div class="route-stop">
            <button type="button" data-map-select="trip-route" data-stop-id={stop.id} aria-pressed="false" disabled>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span><strong>{stop.name}</strong><small>{isAgreed ? stop.description : `${destinationDays(stop.id)} ${text('天行程', destinationDays(stop.id) === 1 ? 'day' : 'days')}`}</small></span>
              <Icon name="arrow-up-right" size={17} />
            </button>
            <a class="city-map-link" href={`https://www.google.com/maps/search/?api=1&query=${stop.lat},${stop.lng}`} target="_blank" rel="noopener noreferrer">{text(`在地图中查看${stop.name}`, `View ${stop.name} in Google Maps`)} <Icon name="external" size={12} /></a>
          </div>)}
          <p class="route-note">{text('连线示意行程顺序。铁路、巴士与古道的具体走法请结合每日安排和官方地图查看。', 'The lines show the order of destinations. Use the daily schedule and official maps for transport and walking details.')}</p>
        </aside>
      </div>
    </section>

    {stays.length > 0 && <section class="trip-stays-section container" id="stays" aria-labelledby="stays-title">
      <div class="section-heading">
        <div><h2 id="stays-title">{text('住宿安排', 'Accommodation')}</h2></div>
        <p class="section-intro">{stays.length} {text('处住宿记录', 'stay records')} · {totalNights} {text('晚', 'nights')}<br />{bookedNights} {text('晚已订', 'nights booked')} · {pendingNights} {text('晚待确认', 'nights awaiting confirmation')}</p>
      </div>
      <div class="stay-summary" aria-label={text('住宿预订概况', 'Accommodation booking summary')}>
        <span><Icon name="check" size={16} /> <strong>{bookedNights}</strong> {text('晚已有预订记录', 'nights have booking records')}</span>
        <span><Icon name="calendar" size={16} /> <strong>{pendingNights}</strong> {text('晚需要确认', 'nights need confirmation')}</span>
        <span>{text('住宿日期按入住、退房计算。', 'Nights are counted from check-in to check-out.')}</span>
      </div>
      <div class="stay-grid">
        {stays.map(stay => <article class="stay-card" id={`stay-${stay.id}`}>
          <div class="stay-card-top"><p class="stay-location"><Icon name="pin" size={14} /> {stay.location}</p><span class:list={['stay-status', { 'stay-status-booked': stay.status === 'booked' }]}>{stay.status === 'booked' && <Icon name="check" size={12} />}{stayStatus(stay)}</span></div>
          <h3>{stay.name}</h3>
          <dl class="stay-dates">
            {stay.checkIns.map(segment => <>
              <div><dt>{text('入住 / 退房', 'Check-in / check-out')}</dt><dd><time datetime={segment.checkIn}>{date(segment.checkIn)}</time><span aria-hidden="true"> → </span><time datetime={segment.checkOut}>{date(segment.checkOut)}</time><span class="stay-night-count">{nightsBetween(segment.checkIn, segment.checkOut)} {text('晚', 'nights')}</span></dd></div>
              {segment.cost && <div class="stay-order-cost"><dt>{text('订单金额', 'Booking amount')}</dt><dd><strong>{money(segment.cost.amount, segment.cost.currency)}</strong><a href={`#cost-${stay.id}-${segment.checkIn}`}>{text('费用详情', 'Cost details')} <Icon name="arrow-down" size={12} /></a></dd></div>}
            </>)}
          </dl>
          <ul class="stay-notes">{stay.notes.map(note => <li>{note}</li>)}</ul>
        </article>)}
      </div>
    </section>}

    <section class="itinerary-section container" id="itinerary" aria-labelledby="itinerary-title">
      <div class="section-heading">
        <div><h2 id="itinerary-title">{text('每日行程', 'Daily itinerary')}</h2></div>
        <p class="section-intro">{text('展开查看时间、换乘和当天提醒。', 'Open a day for times, connections, and reminders.')}</p>
      </div>
      <div class="itinerary-toolbar"><p>{isAgreed ? text('已商定行程', 'Agreed itinerary') : text('行程草案', 'Draft itinerary')} · {dateRange}</p><button type="button" class="expand-button" data-expand-days aria-expanded="false">{text('展开全部日程', 'Expand all days')} <Icon name="plus" size={15} /></button></div>
      <div class="itinerary-list">
        {trip.days.map((day, index) => {
          const overnight = stayById(day.overnightId);
          return <details class="itinerary-day" open={index === 0}>
            <summary>
              <span class="day-index">{text('第', 'DAY ')}{String(dayNumber(day.date)).padStart(2, '0')}{isZh && '天'}</span>
              <span class="day-date"><time datetime={day.date}>{date(day.date)}</time><small>{date(day.date, { weekday: 'short', month: undefined, day: undefined })}</small></span>
              <span class="day-title">{day.title}</span><span class="day-city">{cityName(day.destinationId)}</span><Icon name="chevron-down" size={17} class="day-chevron" />
            </summary>
            <div class:list={['day-content', { 'has-schedule': Boolean(day.schedule?.length) }]}>
              <p class="day-description">{day.description}</p>
              {isThisJapan && (day.type === 'arrival' || day.type === 'departure') && <p class="travel-day-note"><Icon name="train" size={15} />{day.type === 'arrival' ? text('抵达日：办理入境、入住和整理行李，不安排景点。', 'Arrival day: immigration, check-in, and unpacking; no sightseeing planned.') : text('返程日：退房、机场和回程，不安排景点。', 'Departure day: check-out, airport, and the journey home; no sightseeing planned.')}</p>}
              {day.schedule?.length ? <ol class="day-timeline" aria-label={text(`${date(day.date)}时间表`, `${date(day.date)} schedule`)} role="list">
                {day.schedule.map(item => <li class:list={['timeline-entry', { 'timeline-entry-optional': item.optional }]}>
                  <span class="timeline-time">{item.time}</span>
                  <div class="timeline-copy"><p class="timeline-title">{item.title}{item.optional && <span class="timeline-optional">{text('可选', 'Optional')}</span>}</p>{item.description && <p class="timeline-description">{item.description}</p>}
                    <TripReferences sources={sourcesFor(item.sourceIds)} locale={locale} />
                  </div>
                </li>)}
              </ol> : day.ideas.length > 0 && <><span class="day-ideas-title">{text('备选活动', 'SUGGESTED ACTIVITIES')} · {cityName(day.destinationId).toUpperCase()}</span><ul class="day-ideas">{day.ideas.map(idea => <li>{idea}</li>)}</ul></>}
              {day.hike && <aside class="hike-card" aria-label={text('当天徒步信息', 'Walking information')}>
                <p class="hike-route"><Icon name="compass" size={18} /> {day.hike.route}</p>
                <dl class="hike-facts"><div><dt>{text('徒步距离', 'Distance')}</dt><dd>{text('约', 'About ')}{number(day.hike.distanceKm)} {text('公里', 'km')}</dd></div><div><dt>{text('官方参考', 'Official estimate')}</dt><dd>{day.hike.duration}</dd></div>{day.hike.ascentM !== undefined && <div><dt>{text('累计爬升', 'Total ascent')}</dt><dd>{text('约', 'About ')}{number(day.hike.ascentM)} {text('米', 'm')}</dd></div>}</dl>
                <p class="hike-footnote">{text('途中以实际步速、天气和路线情况调整，留好休息时间。', 'Allow time for breaks and adjust to your pace, weather, and trail conditions.')}</p>
              </aside>}
              {day.stamps && <TripStamps collection={day.stamps} sources={sources} locale={locale} />}
              {Boolean(day.alternatives?.length) && <div class="day-alternatives">
                <h3>{text('备选安排', 'Alternative plans')}</h3>
                {day.alternatives!.map(alternative => <details class="day-alternative" id={`alternative-${day.date}-${alternative.id}`} data-day-alternative={alternative.id}>
                  <summary><span class="alternative-label">{text('备选', 'Alternative')}</span><span class="alternative-name">{alternative.title}</span><Icon name="chevron-down" size={16} /></summary>
                  <div class="alternative-content">
                    <p class="alternative-description">{alternative.description}</p>
                    <p class="alternative-scope">{text('此方案整体替代上面的对应安排。', 'Use this option in place of the corresponding main schedule.')}</p>
                    <ol class="day-timeline" aria-label={text(`${alternative.title}时间表`, `${alternative.title} schedule`)} role="list">{alternative.schedule.map(item => <li class:list={['timeline-entry', { 'timeline-entry-optional': item.optional }]}>
                      <span class="timeline-time">{item.time}</span>
                      <div class="timeline-copy"><p class="timeline-title">{item.title}{item.optional && <span class="timeline-optional">{text('可选', 'Optional')}</span>}</p>{item.description && <p class="timeline-description">{item.description}</p>}<TripReferences sources={sourcesFor(item.sourceIds)} locale={locale} /></div>
                    </li>)}</ol>
                    {alternative.notes.length > 0 && <aside class="day-important-notes"><p class="day-note-label">{text('此方案提醒', 'Alternative reminders')}</p><ul>{alternative.notes.map(note => <li>{note}</li>)}</ul></aside>}
                    <TripReferences sources={sourcesFor(alternative.sourceIds)} locale={locale} />
                  </div>
                </details>)}
              </div>}
              {Boolean(day.notes?.length) && <aside class="day-important-notes"><p class="day-note-label">{text('当天提醒', 'DAILY REMINDERS')}</p><ul>{day.notes!.map(note => <li>{note}</li>)}</ul></aside>}
              <TripReferences sources={sourcesFor(day.sourceIds)} locale={locale} label={text('当天资料', 'Day sources')} />
              {overnight && <p class="day-stay"><Icon name="pin" size={15} /><span>{text('当晚住宿', 'Overnight stay')}</span><a href={`#stay-${overnight.id}`}>{overnight.name}</a><span class:list={['stay-status', { 'stay-status-booked': overnight.status === 'booked' }]}>{stayStatus(overnight)}</span></p>}
            </div>
          </details>;
        })}
      </div>
    </section>

    {hasPreparations && <section class="trip-preparations-section container" id="preparations" aria-labelledby="preparations-title">
      <div class="section-heading"><div><h2 id="preparations-title">{text('行前准备', 'Preparations')}</h2></div><p class="section-intro">{text('预订、行李寄存、餐食与换乘。', 'Bookings, luggage, meals, and connections.')}<br />{text('参考班次不代表已购票。', 'Reference departures are not ticket confirmations.')}</p></div>
      {(ticketOptions.length > 0 || bookingWindows.length > 0) && <TripPlanning ticketOptions={ticketOptions} bookingWindows={bookingWindows} sources={sources} locale={locale} />}
      {trip.stampGuide && <TripStampGuide guide={trip.stampGuide} sources={sources} locale={locale} />}
      {practicalNotes.length > 0 && <aside class="practical-panel"><div class="preparation-panel-heading"><Icon name="compass" size={20} /><h3>{text('行李、餐食与换乘', 'Luggage, meals, and connections')}</h3></div><ul class="practical-list">{practicalNotes.map(note => <li>{note}</li>)}</ul></aside>}
    </section>}

    {sources.length > 0 && <section class="trip-sources-section container" id="sources" aria-labelledby="sources-title"><div class="section-heading"><div><h2 id="sources-title">{text('官方资料', 'Official sources')}</h2></div><p class="section-intro">{text('景点、交通与古道的官方资料。', 'Official information for sights, transport, and trails.')}</p></div><TripReferences sources={sources} locale={locale} catalog label={text('查看官方资料', 'View official sources')}><p class="sources-reference-note">{text(`链接中的列车时刻表日期是资料参考日期；列车、巴士与活动安排请按${dateRange}的实际出行日复核。行程中的参考班次不代表已经买票。`, 'Timetable dates identify the reference information. Recheck trains, buses, and event details for your travel dates; listed departures are not purchased tickets.')}</p></TripReferences></section>}
    {hasCosts && <TripCosts stays={stays} sources={sources} travelers={trip.travelers} locale={locale} hasPreparations={hasPreparations} />}
  </div>
</Layout>

<script>
  import '../scripts/trip';
</script>

<style>
  .trip-title-part { display: inline-block; max-width: 100%; }
  .trip-hero-actions { flex-wrap: wrap; }
  .trip-hero-figure { min-width: 0; margin: 0; }
  .rich-subnav-links { min-width: 0; max-width: 100%; overflow-x: auto; scrollbar-width: thin; }
  .rich-subnav-links a { flex-shrink: 0; white-space: nowrap; }
  .route-overview { display: flex; flex-wrap: wrap; gap: 9px 13px; list-style: none; padding: 0; margin: -5px 0 25px; }
  .route-overview li { display: inline-flex; align-items: center; gap: 13px; font-size: 13px; }
  .route-overview li > span:first-child { border: 1px solid var(--line); padding: 5px 12px; border-radius: 4px; background: #fbfaf5; }
  .route-overview-arrow { color: var(--accent-deep); }
  .trip-stays-section, .trip-preparations-section, .trip-sources-section { padding-block: 64px; border-top: 1px solid var(--line); }
  .stay-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 26px; padding: 16px 19px; margin-bottom: 22px; border: 1px solid var(--line); border-radius: 5px; background: var(--paper-deep); }
  .stay-summary > span { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; }
  .stay-summary > span:last-child { color: var(--ink-soft); margin-left: auto; font-size: 11px; }
