---
import Icon from './Icon.astro';
import TripReferences from './TripReferences.astro';
import type { TripSight, TripGalleryPhoto, TripSource } from '../data/types';

interface Props {
  sights: TripSight[];
  photos: TripGalleryPhoto[];
  sources: TripSource[];
  id: string;
  locale?: 'zh-CN' | 'en';
}

const { sights, photos, sources, id, locale = 'en' } = Astro.props;
const isZh = locale === 'zh-CN';
const photosFor = (ids: string[]) => ids.flatMap(photoId => {
  const photo = photos.find(item => item.id === photoId);
  return photo ? [photo] : [];
});
const sourcesFor = (ids?: string[]) => (ids ?? []).flatMap(sourceId => {
  const source = sources.find(item => item.id === sourceId);
  return source ? [source] : [];
});
---
{sights.length > 0 && <section class="day-sights" aria-labelledby={`${id}-sights-title`} data-trip-sights>
  <h3 id={`${id}-sights-title`}>{isZh ? '景点介绍' : 'About the sights'}</h3>
  <div class="sight-grid">
    {sights.map(sight => <article class:list={['sight-card', { 'sight-card-optional': sight.optional }]} id={`${id}-sight-${sight.id}`}>
      <div class="sight-heading"><h4>{sight.name}</h4>{sight.optional && <span class="sight-optional">{isZh ? '备选' : 'Optional'}</span>}</div>
      <p class="sight-introduction">{sight.introduction}</p>
      {sight.visitNote && <p class="sight-visit-note">{sight.visitNote}</p>}
      <div class="sight-photo-links">
        {photosFor(sight.photoIds).map(photo => <a href={`#photo-${photo.id}`} data-gallery-select={photo.id} aria-label={isZh ? `查看${sight.name}图片` : `View a photo of ${sight.name}`}>
          {sight.photoIds.length === 1 ? (isZh ? '查看图片' : 'View photo') : photo.title}<Icon name="arrow-up-right" size={13} />
        </a>)}
      </div>
      <TripReferences sources={sourcesFor(sight.sourceIds)} locale={locale} />
    </article>)}
  </div>
</section>}

<style>
  .day-sights { margin-top: 24px; }
  .day-sights > h3 { margin-bottom: 12px; font-family: var(--sans); font-size: 13px; font-weight: 600; line-height: 1.7; }
  .sight-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .sight-card { min-width: 0; padding: 19px 20px; border: 1px solid var(--line); border-radius: 5px; background: #fbfaf5; }
  .sight-card:only-child { grid-column: 1 / -1; }
  .sight-heading { display: flex; align-items: flex-start; gap: 10px; }
  .sight-heading h4 { min-width: 0; font-family: var(--sans); font-size: 15px; font-weight: 600; line-height: 1.7; }
  .sight-optional { flex-shrink: 0; margin-left: auto; padding: 2px 7px; border: 1px solid #b9462833; border-radius: 3px; background: #dd674508; color: var(--accent-deep); font-size: 10px; line-height: 1.7; }
  .sight-introduction { margin-top: 10px; color: var(--ink-soft); font-size: 13px; line-height: 1.95; }
  .sight-visit-note { margin-top: 9px; color: var(--accent-deep); font-size: 11px; line-height: 1.9; }
  .sight-photo-links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 10px; }
  .sight-photo-links a { display: inline-flex; align-items: center; gap: 5px; max-width: 100%; min-height: 32px; color: var(--accent-deep); font-size: 11px; line-height: 1.8; text-decoration: underline; text-underline-offset: 4px; }
  .sight-photo-links a:hover { color: var(--ink); }
  @media (max-width: 700px) {
    .sight-grid { grid-template-columns: 1fr; gap: 13px; }
    .sight-card { padding: 18px; }
    .sight-introduction { font-size: 14px; }
    .sight-visit-note { font-size: 12px; }
    .sight-photo-links a { font-size: 12px; min-height: 40px; }
  }
  @media print {
    .day-sights { margin-top: 15px; }
    .sight-grid { gap: 10px; }
    .sight-card { padding: 12px; background: white; break-inside: avoid; }
    .sight-heading h4 { font-size: 11px; }
    .sight-introduction, .sight-visit-note { font-size: 10px; }
    .sight-photo-links { display: none; }
  }
</style>
