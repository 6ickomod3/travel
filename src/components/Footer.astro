---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/urls';
interface Props { lang?: 'zh-CN' | 'en'; }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh-CN';
---
<footer class="site-footer">
  <div class="container footer-main">
    <div><a class="brand-link" href={withBase()} aria-label={isZh ? 'Elsewhere 首页' : 'Elsewhere home'}><Brand /></a><p>{isZh ? '把值得记住的地方，慢慢收藏。' : 'For the places that stay with you.'}</p></div>
    <a class="footer-back" href="#top">{isZh ? '回到顶部' : 'Back to the top'} <Icon name="arrow-up-right" size={18} /></a>
  </div>
  <div class="container footer-bottom"><span>{isZh ? '一张属于我们的地图，随每次旅行生长。' : 'A personal atlas. Always a work in progress.'}</span><span>{isZh ? '为每一次出发' : 'Made for the journey'} <span aria-hidden="true">↗</span></span></div>
</footer>
