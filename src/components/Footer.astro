---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/urls';
interface Props { lang?: 'zh-CN' | 'en'; }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh-CN';
---
<footer class="site-footer">
  <div class="container footer-main">
    <a class="brand-link" href={withBase()} aria-label={isZh ? 'Elsewhere 首页' : 'Elsewhere home'}><Brand /></a>
    <a class="footer-back" href="#top">{isZh ? '回到顶部' : 'Back to the top'} <Icon name="arrow-up-right" size={18} /></a>
  </div>
</footer>
