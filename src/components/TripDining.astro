---
import Icon from './Icon.astro';
import BookingBadge from './BookingBadge.astro';
import TripReferences from './TripReferences.astro';
import type { TripDayMeal, TripDiningOption, TripSource } from '../data/types';
import { diningChoiceId, diningMealLabel, diningPhoneHref, diningPolicyLabel, diningSectionId } from '../lib/trip-dining';

interface Props {
  date: string;
  meals?: TripDayMeal[];
  options?: TripDiningOption[];
  sources?: TripSource[];
  locale?: 'zh-CN' | 'en';
}
const { date, meals = [], options = [], sources = [], locale = 'en' } = Astro.props;
const isZh = locale === 'zh-CN';
const text = (zh: string, en: string) => isZh ? zh : en;
const sectionId = diningSectionId(date);
const optionsById = new Map(options.map(option => [option.id, option]));
const groups = meals.map((meal, index) => ({
  ...meal,
  index,
  choices: meal.choices.flatMap(choice => {
    const option = optionsById.get(choice.optionId);
    return option ? [{ choice, option }] : [];
  }),
})).filter(meal => meal.choices.length > 0 || Boolean(meal.notes?.length));
const sourcesFor = (ids?: string[]) => (ids ?? []).flatMap(id => {
  const source = sources.find(item => item.id === id);
  return source ? [source] : [];
});
---
{groups.length > 0 && <section class="day-dining" id={sectionId} aria-labelledby={`${sectionId}-title`} data-day-dining>
  <div class="dining-heading"><Icon name="coffee" size={18} /><h3 id={`${sectionId}-title`}>{text('用餐选项', 'Meal options')}</h3></div>
  {groups.some(meal => meal.choices.length > 0) && <p class="dining-choice-note">{text('餐厅为备选；未标记“已订”的选项尚未确认预约。', 'Restaurants are alternatives. Reservations are unconfirmed unless marked booked.')}</p>}
  {groups.map(meal => <section class="dining-meal" aria-labelledby={`${sectionId}-${meal.meal}-${meal.index}-title`} data-dining-meal={meal.meal}>
    <div class="dining-meal-heading"><h4 id={`${sectionId}-${meal.meal}-${meal.index}-title`}>{diningMealLabel(meal.meal, locale)}</h4>{meal.label && <span>{meal.label}</span>}</div>
    {Boolean(meal.notes?.length) && <ul class="dining-meal-notes">{meal.notes!.map(note => <li>{note}</li>)}</ul>}
    {meal.choices.length > 0 && <ul class="dining-choice-list" role="list">
      {meal.choices.map(({ choice, option }) => {
        const id = diningChoiceId(date, meal.meal, option.id);
        const booked = choice.reservationStatus === 'booked';
        const reservation = option.reservation;
        const phoneHref = diningPhoneHref(reservation?.phone);
        const reserveLabel = choice.requiresItineraryChange
          ? text('调整路线后预约', 'Reserve after changing the route')
          : text('选定后预约', 'Reserve after choosing');
        const checkLabel = text('查看店铺信息', 'View restaurant information');
        return <li class="dining-choice" id={id} aria-labelledby={`${id}-title`} data-dining-choice={option.id} data-dining-status={booked ? 'booked' : 'candidate'} data-dining-route-change={choice.requiresItineraryChange ? 'true' : undefined}>
          <div class="dining-choice-heading"><h5 id={`${id}-title`}>{option.name}</h5>{option.area && <p class="dining-area"><Icon name="pin" size={12} />{option.area}</p>}</div>
          <div class="dining-badges">
            {booked ? <BookingBadge status="booked" locale={locale} /> : <span class="dining-candidate">{text('备选', 'Candidate')}</span>}
            {reservation && <span class:list={['dining-policy', `dining-policy-${reservation.policy}`]}>{diningPolicyLabel(reservation.policy, locale)}</span>}
            {choice.requiresItineraryChange && <span class="dining-route-change"><Icon name="alert" size={12} />{text('需调整路线', 'Route change needed')}</span>}
          </div>
          {option.description && <p class="dining-description">{option.description}</p>}
          {choice.note && <p class="dining-context"><strong>{text('此选项：', 'For this option: ')}</strong>{choice.note}</p>}
          {Boolean(option.notes?.length) && <ul class="dining-option-notes">{option.notes!.map(note => <li>{note}</li>)}</ul>}
          {reservation?.note && <p class="dining-reservation-note">{reservation.note}</p>}
          {!booked && reservation && reservation.policy !== 'none' && (reservation.url || reservation.phone) && <div class="dining-actions">
            {reservation.url && <a href={reservation.url} target="_blank" rel="noopener noreferrer"><span>{reservation.policy === 'check' ? checkLabel : reserveLabel}</span><Icon name="external" size={12} /></a>}
            {reservation.phone && (phoneHref ? <a href={phoneHref}><span>{choice.requiresItineraryChange ? text('调整路线后致电：', 'Call after changing the route: ') : text('选定后致电：', 'Call after choosing: ')}{reservation.phone}</span><Icon name="arrow-up-right" size={12} /></a> : <span>{text('电话：', 'Phone: ')}{reservation.phone}</span>)}
          </div>}
          <TripReferences sources={sourcesFor(option.sourceIds)} locale={locale} />
        </li>;
      })}
    </ul>}
    <TripReferences sources={sourcesFor(meal.sourceIds)} locale={locale} />
  </section>)}
</section>}

<style>
  .day-dining { min-width: 0; margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--daily-nav-height, 128px) + 32px); }
  .dining-heading { display: flex; align-items: center; gap: 9px; }
  .dining-heading > svg { color: var(--ink-soft); }
  .dining-heading h3 { font-family: var(--sans); font-size: 16px; line-height: 1.6; font-weight: 600; }
  .dining-choice-note { margin-top: 8px; color: var(--ink-soft); font-size: 12px; line-height: 1.8; overflow-wrap: anywhere; }
  .dining-meal { min-width: 0; margin-top: 22px; }
  .dining-meal-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 7px 12px; }
  .dining-meal-heading h4 { font-family: var(--sans); font-size: 14px; font-weight: 600; line-height: 1.7; }
  .dining-meal-heading > span { color: var(--ink-soft); font-size: 12px; line-height: 1.8; overflow-wrap: anywhere; }
  .dining-meal-notes, .dining-option-notes { margin: 9px 0 0; padding-left: 18px; color: var(--ink-soft); font-size: 12px; line-height: 1.9; overflow-wrap: anywhere; }
  .dining-meal-notes li + li, .dining-option-notes li + li { margin-top: 5px; }
  .dining-choice-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; min-width: 0; margin: 12px 0 0; padding: 0; list-style: none; }
  .dining-choice { min-width: 0; padding: 16px; border: 1px solid var(--line); border-radius: 5px; background: var(--paper); scroll-margin-top: calc(var(--daily-nav-height, 128px) + 32px); }
  .dining-choice h5 { margin: 0; font-family: var(--sans); font-size: 14px; font-weight: 600; line-height: 1.8; overflow-wrap: anywhere; }
  .dining-area { display: flex; align-items: flex-start; gap: 5px; margin-top: 4px; color: var(--ink-soft); font-size: 11px; line-height: 1.8; overflow-wrap: anywhere; }
  .dining-area > svg { margin-top: 4px; }
  .dining-badges { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .dining-candidate, .dining-policy, .dining-route-change { display: inline-flex; align-items: center; gap: 5px; max-width: 100%; padding: 2px 7px; border: 1px solid var(--line); border-radius: 3px; color: var(--ink-soft); font-size: 10px; line-height: 1.7; overflow-wrap: anywhere; }
  .dining-policy-required, .dining-route-change { border-color: #d7b38b; color: var(--pending); background: var(--pending-soft); }
  .dining-route-change { font-weight: 500; }
  .dining-description, .dining-context, .dining-reservation-note { margin-top: 10px; color: var(--ink-soft); font-size: 12px; line-height: 1.9; overflow-wrap: anywhere; }
  .dining-context { color: var(--ink); }
  .dining-context strong { font-weight: 500; }
  .dining-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 5px 14px; margin-top: 10px; color: var(--accent-deep); font-size: 11px; line-height: 1.8; overflow-wrap: anywhere; }
  .dining-actions a { display: inline-flex; align-items: center; gap: 5px; max-width: 100%; min-height: 36px; text-decoration: underline; text-underline-offset: 3px; }
  .dining-actions a > span { min-width: 0; overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .dining-choice-list { grid-template-columns: minmax(0, 1fr); }
    .dining-choice { padding: 14px; }
    .dining-choice-note, .dining-description, .dining-context, .dining-reservation-note, .dining-meal-notes, .dining-option-notes { font-size: 13px; }
    .dining-actions { font-size: 12px; }
    .dining-actions a { min-height: 40px; }
  }
  @media print {
    .day-dining { margin-top: 16px; padding-top: 14px; }
    .dining-heading, .dining-meal-heading { break-after: avoid; }
    .dining-heading h3 { font-size: 12px; }
    .dining-meal { margin-top: 14px; }
    .dining-meal-heading h4, .dining-choice h5 { font-size: 11px; }
    .dining-choice-list { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .dining-choice { break-inside: avoid; padding: 11px; background: white; }
    .dining-choice-note, .dining-meal-heading > span, .dining-area, .dining-description, .dining-context, .dining-reservation-note, .dining-meal-notes, .dining-option-notes { font-size: 10px; }
    .dining-actions { font-size: 9px; }
    .dining-actions a { min-height: 0; }
    .dining-candidate, .dining-policy, .dining-route-change { color: var(--ink); background: white; font-size: 9px; }
  }
</style>
