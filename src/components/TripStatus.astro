---
import type { Trip } from '../data/trips';
import { displayStatus } from '../lib/trips';
interface Props { trip: Trip; }
const { trip } = Astro.props;
---
<span class="trip-status" data-trip-status data-start-date={trip.startDate} data-end-date={trip.endDate} data-status={trip.status}><span class="status-dot"></span><span data-status-label>{displayStatus(trip)}</span></span>
<script>
  import { displayStatus } from '../lib/trips';
  import type { TripStatus } from '../data/trips';
  document.querySelectorAll<HTMLElement>('[data-trip-status]').forEach((element) => {
    const label = element.querySelector('[data-status-label]');
    if (label) label.textContent = displayStatus({ startDate: element.dataset.startDate!, endDate: element.dataset.endDate!, status: element.dataset.status as TripStatus });
  });
</script>
