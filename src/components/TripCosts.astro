---
import Icon from './Icon.astro';
import type { TripStay, TripSource } from '../data/trips';
import { durationDays, formatDate } from '../lib/trips';

interface Props {
  stays: TripStay[];
  sources?: TripSource[];
  travelers?: number;
  locale?: 'zh-CN' | 'en';
  hasPreparations?: boolean;
}
const { stays, sources = [], travelers, locale = 'en', hasPreparations = false } = Astro.props;
const isZh = locale === 'zh-CN';
const dateLocale = isZh ? 'zh-CN' : 'en-US';
const text = (zh: string, en: string) => isZh ? zh : en;
const money = (value: number, currency: string) => new Intl.NumberFormat(dateLocale, { style: 'currency', currency }).format(value);
const date = (value: string) => formatDate(value, { month: 'short', day: 'numeric' }, dateLocale);
const rows = stays.flatMap(stay => stay.checkIns.map(segment => ({
  stay, segment,
  id: `cost-${stay.id}-${segment.checkIn}`,
  nights: durationDays({ startDate: segment.checkIn, endDate: segment.checkOut }) - 1,
  details: [
    ...(segment.cost?.includes ?? []).map(note => `${text('已含：', 'Includes: ')}${note}`),
    ...(segment.cost?.notes ?? []),
  ],
}))).sort((a, b) => a.segment.checkIn.localeCompare(b.segment.checkIn));
const pricedRows = rows.flatMap(row => row.segment.cost ? [{ ...row, cost: row.segment.cost }] : []);
const pricedNights = pricedRows.reduce((total, row) => total + row.nights, 0);
const pendingNights = rows.filter(row => !row.segment.cost).reduce((total, row) => total + row.nights, 0);
const summaries = [...new Set(pricedRows.map(row => row.cost.currency))].map(currency => {
  const costs = pricedRows.filter(row => row.cost.currency === currency);
  const bookingTotal = costs.reduce((total, row) => total + row.cost.amount, 0);
  const additions = costs.flatMap(row => row.cost.estimatedAdditional ?? []);
  const additionalTotal = additions.reduce((total, extra) => total + extra.amount, 0);
  return { currency, bookingTotal, additionalTotal, hasAdditional: additions.length > 0, budget: bookingTotal + additionalTotal };
});
const referenceIds = [...new Set(pricedRows.flatMap(row => row.cost.sourceIds ?? []))];
const references = referenceIds.flatMap(id => { const source = sources.find(item => item.id === id); return source ? [source] : []; });
---
<section class="trip-costs-section container" id="costs" aria-labelledby="costs-title">
  <div class="section-heading">
    <div><h2 id="costs-title">{text('费用', 'Costs')}</h2></div>
    <p class="section-intro">{text('住宿', 'Accommodation')} · {pricedRows.length} {text('笔订单', pricedRows.length === 1 ? 'booking' : 'bookings')} · {pricedNights} {text('晚已提供金额', 'nights priced')}{pendingNights > 0 && <> · {pendingNights} {text('晚价格待补', 'nights awaiting prices')}</>}</p>
  </div>
  <p class="cost-basis">{text('以下为每笔住宿订单总价，不是每人价，也不代表已付款。', 'These are totals for each accommodation booking, not per-person prices or confirmed payments.')}{travelers !== undefined && travelers > 0 && <> {travelers} {text('人同行。', travelers === 1 ? 'traveler.' : 'travelers.')}</>}</p>
  {summaries.map(summary => <div class="cost-currency-summary" data-cost-currency={summary.currency}>
    <div class:list={['cost-summary-grid', { 'cost-summary-grid-single': !summary.hasAdditional }]}>
      <dl class="cost-metric"><dt>{text('订单金额合计', 'Booking total')} <span>{summary.currency}</span></dt><dd data-cost-total="bookings">{money(summary.bookingTotal, summary.currency)}</dd></dl>
      {summary.hasAdditional && <>
        <dl class="cost-metric"><dt>{text('预计另付费用', 'Estimated additional charges')} <span>{summary.currency}</span></dt><dd data-cost-total="additional">{money(summary.additionalTotal, summary.currency)}</dd></dl>
        <dl class="cost-metric cost-metric-budget"><dt>{text('当前住宿预算', 'Current accommodation budget')} <span>{summary.currency}</span></dt><dd data-cost-total="budget">{money(summary.budget, summary.currency)}</dd></dl>
      </>}
    </div>
    {travelers !== undefined && travelers > 1 && <p class="cost-share">{text('按', 'Split between ')}{travelers}{text('人均摊，约', ' travelers, about ')}<strong data-cost-share>{money(summary.budget / travelers, summary.currency)}</strong>{text('／人。', ' per person.')}</p>}
  </div>)}
  <div class="cost-table-wrapper" tabindex="0" role="region" aria-label={text('住宿费用明细，可横向滚动', 'Accommodation cost details, horizontally scrollable')}>
    <table class="cost-table">
      <caption class="sr-only">{text('住宿订单与预计额外费用', 'Accommodation bookings and estimated additional charges')}</caption>
      <thead><tr><th scope="col">{text('入住 / 退房', 'Check-in / check-out')}</th><th scope="col">{text('住宿', 'Accommodation')}</th><th scope="col">{text('订单金额', 'Booking amount')}</th><th scope="col">{text('预计另付', 'Estimated additional')}</th></tr></thead>
      <tbody>{rows.map(row => <tr id={row.id} data-cost-row={row.id} class:list={{ 'cost-row-pending': !row.segment.cost }}>
        <td class="cost-date"><time datetime={row.segment.checkIn}>{date(row.segment.checkIn)}</time><span aria-hidden="true"> → </span><time datetime={row.segment.checkOut}>{date(row.segment.checkOut)}</time><small>{row.nights} {text('晚', row.nights === 1 ? 'night' : 'nights')}</small></td>
        <th scope="row" class="cost-stay"><a href={`#stay-${row.stay.id}`}>{row.stay.name}</a>{row.details.length > 0 && <ul>{row.details.map(note => <li>{note}</li>)}</ul>}</th>
        <td class="cost-amount" data-booking-amount={row.segment.cost?.amount}>{row.segment.cost ? <>{money(row.segment.cost.amount, row.segment.cost.currency)}<small>{row.segment.cost.currency}</small></> : <><span>{text('待补', 'To be added')}</span><small>{text('未计入合计', 'Excluded from totals')}</small></>}</td>
        <td class="cost-additional">{(row.segment.cost?.estimatedAdditional?.length ?? 0) > 0 ? row.segment.cost!.estimatedAdditional!.map(extra => <div data-additional-amount={extra.amount}><span>{money(extra.amount, row.segment.cost!.currency)}</span><small>{extra.label}</small></div>) : <span aria-label={text('未提供额外费用记录', 'No additional cost recorded')}>—</span>}</td>
      </tr>)}</tbody>
    </table>
  </div>
  <p class="cost-scope">{pendingNights > 0 && <>{pendingNights} {text('晚住宿价格待补；', 'accommodation nights are unpriced. ')}</>}{text('以上是已知住宿部分预算。交通、未含餐食、景点等费用另计。', 'This is a partial accommodation budget. Transport, meals not included, and activities are separate.')}{summaries.length > 1 && <> {text('不同币种分别合计，未换汇合并。', 'Currencies are totaled separately, without conversion.')}</>}</p>
  {references.length > 0 && <div class="cost-source-links">{references.map(source => <a href={source.url} target="_blank" rel="noopener noreferrer"><span>{source.label}</span><Icon name="external" size={12} /></a>)}</div>}
  {hasPreparations && <a class="cost-planning-link" href="#preparations">{text('查看票券方案与行前准备', 'View ticket options and preparations')} <Icon name="arrow-up-right" size={14} /></a>}
</section>

<style>
  .trip-costs-section { padding-block: 64px; border-top: 1px solid var(--line); }
  .cost-basis { margin: -9px 0 24px; color: var(--ink-soft); font-size: 13px; line-height: 1.9; }
  .cost-currency-summary + .cost-currency-summary { margin-top: 25px; }
  .cost-summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .cost-summary-grid-single { grid-template-columns: minmax(0, 1fr); }
  .cost-metric { min-width: 0; margin: 0; padding: 23px; border: 1px solid var(--line); border-radius: 6px; background: #fbfaf5; }
  .cost-metric dt { display: flex; align-items: center; gap: 10px; color: var(--ink-soft); font-size: 12px; }
  .cost-metric dt > span { margin-left: auto; font-size: 10px; }
  .cost-metric dd { margin: 11px 0 0; font-size: clamp(25px, 2.8vw, 35px); line-height: 1.2; font-weight: 500; font-variant-numeric: tabular-nums; }
  .cost-metric-budget { border-color: #36574330; background: #36574308; }
  .cost-share { margin-top: 13px; font-size: 12px; color: var(--ink-soft); }
  .cost-share strong { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }
  .cost-table-wrapper { min-width: 0; max-width: 100%; margin-top: 25px; overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; }
  .cost-table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 12px; text-align: left; background: #fbfaf5; }
  .cost-table thead { background: var(--paper-deep); }
  .cost-table th, .cost-table td { padding: 18px; font-weight: 400; vertical-align: top; }
  .cost-table thead th { font-weight: 600; }
  .cost-table tbody tr + tr { border-top: 1px solid var(--line); }
  .cost-date { width: 20%; font-size: 11px; }
  .cost-date small, .cost-amount small, .cost-additional small { display: block; margin-top: 5px; color: var(--ink-soft); font-size: 10px; }
  .cost-stay { width: 42%; }
  .cost-stay > a { font-weight: 500; text-decoration: underline; text-underline-offset: 4px; }
  .cost-stay ul { margin: 8px 0 0; padding-left: 16px; color: var(--ink-soft); font-size: 11px; line-height: 1.9; }
  .cost-amount, .cost-additional { font-size: 14px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .cost-additional > div + div { margin-top: 8px; }
  .cost-row-pending { background: var(--paper-deep); }
  .cost-row-pending .cost-amount > span { color: var(--accent-deep); }
  .cost-scope { margin-top: 18px; font-size: 12px; line-height: 1.9; color: var(--ink-soft); }
  .cost-source-links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 15px; }
  .cost-source-links a { display: inline-flex; align-items: flex-start; gap: 5px; max-width: 100%; color: var(--accent-deep); font-size: 11px; text-decoration: underline; text-underline-offset: 4px; }
  .cost-source-links span { min-width: 0; overflow-wrap: anywhere; }
  .cost-source-links svg { flex-shrink: 0; margin-top: 3px; }
  .cost-planning-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; color: var(--accent-deep); font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 800px) { .trip-costs-section { padding-block: 48px; } .cost-summary-grid { grid-template-columns: minmax(0, 1fr); gap: 14px; } .cost-metric { padding: 20px; } .cost-metric dd { font-size: 29px; } }
  @media (max-width: 600px) { .trip-costs-section { padding-block: 44px; } .cost-basis, .cost-scope { font-size: 13px; } }
  @media print { .trip-costs-section { padding-block: 20px; border: 0; } .cost-summary-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; } .cost-summary-grid-single { grid-template-columns: minmax(0, 1fr); } .cost-metric { padding: 13px; background: white; } .cost-metric dd { font-size: 21px; } .cost-metric dt, .cost-basis, .cost-scope { font-size: 10px; } .cost-table-wrapper { overflow: visible; } .cost-table { min-width: 0; } .cost-table th, .cost-table td { padding: 10px; } .cost-amount, .cost-additional { font-size: 11px; } .cost-stay ul { font-size: 9px; } .cost-table tbody tr { break-inside: avoid; } .cost-planning-link { display: none; } }
</style>
